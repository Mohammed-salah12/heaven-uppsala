# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# The port the API server listens on
PORT=5000

# MongoDB connection string.
#  • Local (docker-compose):  mongodb://127.0.0.1:27017/heaven
#  • MongoDB Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heaven?retryWrites=true&w=majority
# Leave blank AND set USE_MEMORY_DB=true to run a throwaway in-memory database (no install needed).
MONGODB_URI=mongodb+srv://lenaalhoor418_db_user:moh1232180@restaurang.hy0kfnn.mongodb.net/

# Set to "true" to spin up an in-memory MongoDB (great for a quick demo / CI).
# When true, MONGODB_URI is ignored. Data is wiped when the process exits.
USE_MEMORY_DB=false

# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGIN=http://localhost:3000

# Secret token required (via the `x-admin-token` header) for admin endpoints
# such as adding a new language or editing translations. Change this!
ADMIN_TOKEN=change-me-please
