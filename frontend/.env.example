# ─────────────────────────────────────────────────────────────
# Frontend environment variables — this is a client-only site.
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# easyTable credentials for live table booking (https://api.easytable.com).
# These are called DIRECTLY FROM THE BROWSER — there is no backend to hold
# secrets — so anything here ships inside the built JS and is visible to
# anyone who opens devtools. That tradeoff was chosen deliberately; see
# README "Table booking" for the full writeup and the fallback plan if
# easyTable turns out to block cross-origin (CORS) browser requests.
#
# Until these are set, "Boka bord" shows a friendly "please call us"
# message instead of a broken booking form.
NEXT_PUBLIC_EASYTABLE_API_KEY=
NEXT_PUBLIC_EASYTABLE_PLACE_TOKEN=
# Optional — a separate easyTable place for the à la carte Bakfickan option;
# falls back to NEXT_PUBLIC_EASYTABLE_PLACE_TOKEN when blank.
NEXT_PUBLIC_EASYTABLE_PLACE_TOKEN_BAKFICKAN=
